# Runtime configuration for the agenticwf-agent container (docker/podman --env-file).
# Install as /etc/agenticwf/agent.env.

# Who authenticates requests:
#   authsvc (default)  behind Caddy + the AgenticWF auth service (docs/deployment.md)
#   local              a personal agent without Caddy or authsvc: a personal access token,
#                      the container's PostgreSQL (docs/local.md). The AuthContext secret
#                      below is not used then.
# AGENT_AUTH_MODE=authsvc

# Local mode only: the address your browser uses (the published port), for the link printed
# to the logs; and who the local user is (default: login `agent`, the default scopes).
# AGENT_PUBLIC_URL=http://localhost:8765
# AGENT_LOCAL_USER=wguan
# AGENT_LOCAL_NAME=Wen Guan
# AGENT_LOCAL_SCOPES=app:access agent:use code:read code:write knowledge:read dataset:read dataset:write

# AuthContext secret shared with authsvc. The default reads it from the file mounted at
# /run/secrets/auth_context_secret (see docs/deployment.md §2); prefer that over
# putting the value here.
# AUTH_CONTEXT_SECRET_FILE=/run/secrets/auth_context_secret
# Or the value itself; the entrypoint moves it into /var/lib/agenticwf-agent/secrets.
# AUTH_CONTEXT_SECRET=

# Require that each signed context was issued for this exact method and path. Keep on
# unless a proxy rewrites paths between authsvc's /verify and this service.
# AUTH_BIND_REQUEST=true

# Must match `required_scopes` in AgenticWF-auth's policy.yaml (account approval).
# AGENT_REQUIRED_SCOPES=app:access

# Longest Server-Sent Events connection (s); streams also end when the token expires.
# AGENT_MAX_STREAM_SECONDS=3600

# Database created by the entrypoint in the container's PostgreSQL. The URL the agent uses
# is in /etc/agenticwf/agent.cfg ([database] default); change both together.
# AGENT_DB_NAME=agent

# Networking. With `--network host` keep 127.0.0.1 so only Caddy can reach the service;
# with bridge networking (-p 127.0.0.1:8000:8000) use 0.0.0.0.
# LISTEN_HOST=127.0.0.1
# PORT=8000
# LOG_LEVEL=info

# Model provider credentials, named by api_key_env in agent.cfg (docs/agent-models.md). Keys
# that managers add through the API are stored encrypted in the database instead.
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# VLLM_API_KEY=
# CERN_AIGW_API_KEY=            # the CERN AI gateway (aigw.cern.ch): chat models and embeddings

# Web search provider keys ([web_search] in agent.cfg). DuckDuckGo needs none; a listed provider
# whose key is not set is left out with a warning.
# TAVILY_API_KEY=

# The key that encrypts those stored API keys. The entrypoint creates it on first boot in
# /var/lib/agenticwf-agent/secrets/secrets_key; set this to keep it elsewhere (e.g. a mounted
# secret). Losing it makes stored API keys unreadable.
# AGENT_SECRETS_KEY_FILE=/var/lib/agenticwf-agent/secrets/secrets_key

# Worker processes beside the API process, sharing the jobs through the database (docs/deployment.md,
# Worker processes). 0 (default): every job runs in the API process.
# AGENT_WORKER_PROCESSES=2

# OpenTelemetry (docs/deployment.md §8): off unless an OTLP endpoint is set. Spans of requests,
# jobs, model and tool calls go over OTLP/HTTP to a collector, e.g. Jaeger on the same Docker
# network (its port 4318). The API process is service `agenticwf-agent`, worker processes
# `agenticwf-agent-worker`; OTEL_SERVICE_NAME names them all alike.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4318
# OTEL_TRACES_SAMPLER=parentbased_traceidratio
# OTEL_TRACES_SAMPLER_ARG=0.25
# The chat page's trace view links each step and call to its trace here ({trace_id} is replaced).
# AGENT_TRACE_URL=http://localhost:16686/trace/{trace_id}
# Metrics need an endpoint that takes them (Jaeger does not): Prometheus's OTLP receiver, or
# OTEL_METRICS_EXPORTER=otlp when OTEL_EXPORTER_OTLP_ENDPOINT is an OpenTelemetry Collector.
# OTEL_EXPORTER_OTLP_METRICS_ENDPOINT=http://prometheus:9090/api/v1/otlp/v1/metrics
